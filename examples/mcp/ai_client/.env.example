# Copy this file to .env and fill in the values for whichever demo(s) you run.
# .env is gitignored — never commit real credentials.

# Azure OpenAI (for azure_openai_demo.py)
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_PLAN=gpt-5.4

# Plain OpenAI (for openai_demo.py)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Anthropic (for anthropic_demo.py)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# younit / EFG ONE credentials — required by all three demos, since each
# spawns the MCP server (examples/mcp/server.py), which needs to authenticate.
TRADING_ID=
API_KEY=

# MCP safety limits (optional; defaults shown). Environment variables take precedence.
# Read-only vs trading is NOT set here: see READ_ONLY at the top of
# _mcp_bridge.py (default: read-only).

# Max value (quantity x limit price) of one order, in EGP. 0 turns the cap off.
# While the cap is on, market orders (no limit price) are rejected.
# EFG_MCP_MAX_ORDER_VALUE_EGP=1000

# Max orders the server sends per day. Resets at midnight Cairo time and when
# the server restarts. 0 turns the limit off.
# EFG_MCP_MAX_DAILY_ORDERS=100