# Copy this file to .env and fill in the values for whichever demo(s) you run.
# .env is gitignored — never commit real credentials.

# Azure OpenAI (for azure_openai_demo.py)
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_PLAN=gpt-5.4

# Plain OpenAI (for openai_demo.py)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Anthropic (for anthropic_demo.py)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# younit / EFG ONE credentials — required by all three demos, since each
# spawns the MCP server (examples/mcp/server.py), which needs to authenticate.
EFG_PARTNER_ID=
EFG_PARTNER_SECRET=
EFG_TRADING_UUID=
EFG_SIMULATION=false
