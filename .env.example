TRADING_ID=your-trading-id
API_KEY=your-api-key

EFG_LOG_LEVEL=WARNING

# --- MCP server safety settings (optional) ---
# Environment variables override the values in this file.

# Order tools (buy, sell, amend, cancel) are enabled ONLY when this is exactly "false".
# EFG_MCP_READONLY=true

# Maximum value of one order in EGP (quantity x limit price). 0 turns the cap off.
# While the cap is on, market orders (no limit price) are rejected.
# EFG_MCP_MAX_ORDER_VALUE_EGP=1000

# Maximum orders the MCP server sends per day.
# Resets at midnight Cairo time and whenever the server restarts. 0 turns the limit off.
# EFG_MCP_MAX_DAILY_ORDERS=100
